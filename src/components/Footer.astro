---
---

<footer class="relative z-10 px-6 pb-10 md:pb-14">

    <div class="max-w-7xl mx-auto">

        <div class="rounded-[32px] overflow-hidden border border-white/5 bg-[#0d1016]/70 backdrop-blur-xl">

            <!-- Main -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 px-8 md:px-14 py-14 md:py-16">

                <!-- Left -->
                <div class="max-w-2xl">

                    <!-- Small label -->
                    <div class="flex items-center gap-4 mb-8">

                        <div class="w-12 h-px bg-[#cbb190]/40"></div>

                        <span class="text-[#cbb190] uppercase tracking-[0.35em] text-xs">
                            Juan Galisteo
                        </span>

                    </div>

                    <!-- Title -->
                    <h2 class="text-3xl md:text-5xl font-black leading-[1.1] tracking-tight text-[#f5f7fa] mb-6">

                        Desarrollador web

                    </h2>

                    <!-- Text -->
                    <p class="text-[#7f848c] text-base md:text-lg leading-relaxed max-w-xl">

                        Experiencias digitales modernas con estructura sólida, diseño visual y funcionalidad enfocada en crear sistemas actuales.

                    </p>

                </div>

                <!-- Right -->
                <div class="flex items-end justify-start lg:justify-end"></div>

            </div>

            <!-- Bottom -->
            <div class="border-t border-white/5 px-8 md:px-14 py-6 flex flex-col md:flex-row items-center justify-between gap-4">

                <p class="text-[#7f848c] text-sm text-center md:text-left">

                    © 2026 • All rights reserved

                </p>

                <div class="flex items-center gap-3 text-[#7f848c]/70 uppercase tracking-[0.20em] text-[11px]">

                    <span>Design</span>

                    <span class="text-[#cbb190]/40">•</span>

                    <span>Development</span>

                    <span class="text-[#cbb190]/40">•</span>

                    <span>Systems</span>

                </div>

            </div>

        </div>

    </div>

</footer>