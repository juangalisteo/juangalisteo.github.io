---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="hero">

		<!-- Background -->
		<div class="hero-bg"></div>
		<div class="hero-overlay"></div>

		<!-- Content -->
		<div class="hero-content">

			<!-- Logo -->
			<div class="logo-box">
				<span>JG</span>
			</div>

			<!-- Title -->
			<h1>
				Juan Galisteo
			</h1>

			<!-- Subtitle -->
			<p>
				Desarrollador y creador de experiencias digitales
				enfocadas en la calidad, el diseño y el detalle.
			</p>

			<!-- Buttons -->
			<div class="hero-buttons">

				<a href="#">
					Ver proyectos
				</a>

				<a href="#">
					Contactar
				</a>

			</div>

			<!-- Socials -->
			<div class="socials">

				<a href="https://github.com/juangalisteo" target="_blank">
					GitHub
				</a>

				<a href="#" target="_blank">
					LinkedIn
				</a>

				<a href="#" target="_blank">
					Instagram
				</a>

			</div>

		</div>

	</section>
</Layout>

<style>

	:global(body){
		margin:0;
		background:#050505;
		font-family:Inter, sans-serif;
		color:white;
		overflow-x:hidden;
	}

	.hero{
		position:relative;
		width:100%;
		min-height:100vh;
		display:flex;
		align-items:center;
		justify-content:center;
		padding:40px;
		box-sizing:border-box;
	}

	.hero-bg{
		position:absolute;
		inset:0;
		background-image:url('/hero-bg.jpg');
		background-size:cover;
		background-position:center;
		filter:brightness(0.35);
	}

	.hero-overlay{
		position:absolute;
		inset:0;
		background:
			radial-gradient(circle at center, rgba(176,151,109,0.15), transparent 50%),
			linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.8));
	}

	.hero-content{
		position:relative;
		z-index:2;
		max-width:900px;
		text-align:center;
	}

	.logo-box{
		width:90px;
		height:90px;
		margin:0 auto 40px;
		border:1px solid rgba(176,151,109,0.5);
		border-radius:24px;
		display:flex;
		align-items:center;
		justify-content:center;
		background:rgba(255,255,255,0.03);
		backdrop-filter:blur(10px);
		box-shadow:0 0 40px rgba(176,151,109,0.15);
	}

	.logo-box span{
		font-size:42px;
		font-weight:700;
		color:#D6B36A;
	}

	h1{
		font-size:92px;
		line-height:1;
		margin:0;
		font-weight:800;
		letter-spacing:-4px;
		background:linear-gradient(to right, #ffffff, #D6B36A);
		-webkit-background-clip:text;
		-webkit-text-fill-color:transparent;
	}

	p{
		margin:35px auto 0;
		max-width:700px;
		font-size:28px;
		line-height:1.5;
		color:rgba(255,255,255,0.75);
	}

	.hero-buttons{
		margin-top:50px;
		display:flex;
		justify-content:center;
		gap:20px;
		flex-wrap:wrap;
	}

	.hero-buttons a{
		padding:18px 38px;
		border-radius:16px;
		text-decoration:none;
		font-weight:600;
		font-size:17px;
		transition:0.3s;
	}

	.hero-buttons a:first-child{
		background:#D6B36A;
		color:black;
		box-shadow:0 0 25px rgba(214,179,106,0.35);
	}

	.hero-buttons a:first-child:hover{
		transform:translateY(-3px);
		background:#e6c27b;
	}

	.hero-buttons a:last-child{
		border:1px solid rgba(255,255,255,0.2);
		color:white;
		background:rgba(255,255,255,0.03);
		backdrop-filter:blur(10px);
	}

	.hero-buttons a:last-child:hover{
		transform:translateY(-3px);
		border-color:#D6B36A;
	}

	.socials{
		margin-top:50px;
		display:flex;
		justify-content:center;
		gap:30px;
		flex-wrap:wrap;
	}

	.socials a{
		color:rgba(255,255,255,0.65);
		text-decoration:none;
		font-size:16px;
		transition:0.3s;
	}

	.socials a:hover{
		color:#D6B36A;
	}

	@media(max-width:768px){

		h1{
			font-size:58px;
			letter-spacing:-2px;
		}

		p{
			font-size:20px;
		}

		.logo-box{
			width:75px;
			height:75px;
		}

		.logo-box span{
			font-size:34px;
		}

	}

</style>